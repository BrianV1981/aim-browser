{
  "name": "aim-browser",
  "version": "1.3.1",
  "description": "Persistent headed Chromium CDP engine and agent skill suite for A.I.M. \u2014 real-browser automation without Puppeteer/Playwright.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./skill-utils": "./src/skill-utils.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "aim-*.skill/**/*",
    "scripts/install-skills.sh",
    "docs/**/*",
    "README.md",
    "LICENSE",
    "VERSION",
    "VERSION.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "daemon:start": "bash src/daemon/start.sh",
    "daemon:stop": "bash src/daemon/stop.sh",
    "daemon:check": "bash src/daemon/check.sh",
    "skill": "node aim-browser.skill/scripts/run.js",
    "google-ai": "node aim-google-ai.skill/scripts/run.js",
    "google-ai-chat": "node aim-google-ai-chat.skill/scripts/run.js",
    "google-web": "node aim-google-web.skill/scripts/run.js",
    "google-news": "node aim-google-news.skill/scripts/run.js",
    "page-fetch": "node aim-page-fetch.skill/scripts/run.js",
    "screenshot-url": "node aim-screenshot-url.skill/scripts/run.js",
    "youtube-meta": "node aim-youtube-meta.skill/scripts/run.js",
    "maps-place": "node aim-maps-place.skill/scripts/run.js",
    "form-fill": "node aim-form-fill.skill/scripts/run.js",
    "login-hold": "node aim-login-hold.skill/scripts/run.js",
    "web-diff": "node aim-web-diff.skill/scripts/run.js",
    "install-skills": "bash scripts/install-skills.sh"
  },
  "keywords": [
    "cdp",
    "chromium",
    "chrome-devtools-protocol",
    "browser-automation",
    "aim",
    "headed-browser"
  ],
  "author": "BrianV1981",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianV1981/aim-browser.git"
  },
  "bugs": {
    "url": "https://github.com/BrianV1981/aim-browser/issues"
  },
  "homepage": "https://github.com/BrianV1981/aim-browser#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-mock": "^30.3.0"
  }
}
